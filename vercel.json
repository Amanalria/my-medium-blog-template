{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Pragma": "no-cache",
        "Expires": "0"
      },
      "continue": true
    },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/index\\.html$", "dest": "/index.html" },
    { "src": "^/admin/?$", "dest": "/admin.html" },
    { "src": "^/about/?$", "dest": "/about.html" },
    { "src": "^/contact/?$", "dest": "/contact.html" },
    { "src": "^/privacy/?$", "dest": "/privacy.html" },
    { "src": "^/terms/?$", "dest": "/terms.html" },
    { "src": "^/disclaimer/?$", "dest": "/disclaimer.html" },
    { "src": "^/(styles\\.css|app\\.js|post\\.js|admin\\.js|supabase-client\\.js|supabase_schema\\.sql|robots\\.txt|sitemap\\.xml)$", "dest": "/$1" },
    { "src": "^/([a-zA-Z0-9_-]+)/?$", "dest": "/post.html" }
  ]
}
