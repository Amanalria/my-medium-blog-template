{
  "routes": [
    {
      "src": "^/(admin\\.js|supabase-client\\.js)$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/$1"
    },
    {
      "src": "^/(styles\\.css|app\\.js|post\\.js|articles-preload\\.js|robots\\.txt|sitemap\\.xml|sitemap\\.xsl|ads\\.txt|404\\.html)$",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
      },
      "dest": "/$1"
    },
    {
      "src": "^/(register|login|terms)\\.php.*$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/.*\\.php.*$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/$",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=60, stale-while-revalidate=86400"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/index\\.html$",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=60, stale-while-revalidate=86400"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/aman/?$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/admin.html"
    },
    {
      "src": "^/about/?$",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
      },
      "dest": "/about.html"
    },
    {
      "src": "^/contact/?$",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
      },
      "dest": "/contact.html"
    },
    {
      "src": "^/privacy/?$",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
      },
      "dest": "/privacy.html"
    },
    {
      "src": "^/terms/?$",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
      },
      "dest": "/terms.html"
    },
    {
      "src": "^/disclaimer/?$",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
      },
      "dest": "/disclaimer.html"
    },
    {
      "src": "^/articles/?$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/articles.html"
    },
    {
      "src": "^/articles_data\\.json$",
      "headers": {
        "Cache-Control": "public, max-age=60"
      },
      "dest": "/articles_data.json"
    },
    {
      "src": "^/e0f7a934bd824d5598ba9622d715ac90\\.txt$",
      "dest": "/e0f7a934bd824d5598ba9622d715ac90.txt"
    },
    {
      "src": "^/api/index-url/?$",
      "dest": "/api/index-url.js"
    },
    {
      "src": "^/api/index-url\\.js$",
      "dest": "/api/index-url.js"
    },
    {
      "src": "^/([a-zA-Z0-9_-]+)/?$",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=60, stale-while-revalidate=86400"
      },
      "dest": "/post.html"
    }
  ]
}
