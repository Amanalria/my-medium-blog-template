{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin/?", "destination": "/admin.html" },
    { "source": "/admin.html", "destination": "/admin.html" },
    { "source": "/about/?", "destination": "/about.html" },
    { "source": "/contact/?", "destination": "/contact.html" },
    { "source": "/privacy/?", "destination": "/privacy.html" },
    { "source": "/terms/?", "destination": "/terms.html" },
    { "source": "/disclaimer/?", "destination": "/disclaimer.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/:slug((?!styles|app|admin|post|supabase-client|assets|favicon|.*\\..*).*)", "destination": "/post.html" }
  ]
}
